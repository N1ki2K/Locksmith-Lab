# Copy to secured/.env for Docker Compose interpolation. Replace every placeholder locally.
DB_USER=locksmith_secured
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=locksmith_secured
DB_PORT=5433

# API settings (also used when running secured/api locally).
PORT=3001
DB_HOST=127.0.0.1
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5174
NODE_ENV=development
# Set TRUST_PROXY=true only when production traffic arrives through one trusted proxy.
TRUST_PROXY=false

# Frontend setting (secured/frontend/.env.local). API URL includes the /api prefix.
VITE_API_URL=http://localhost:3001/api

# Integration tests must use a separate PostgreSQL database with "test" in its name.
TEST_DATABASE_URL=postgres://locksmith_secured:replace-me@127.0.0.1:5433/locksmith_secured_test
